{
  "name": "magpie-muse-web",
  "version": "0.11.0",
  "description": "Magpie provider plugin for muse.ai: sign in to each account in a browser window, use Muse Spark with tool calls in Codex, OpenCode and other agents, and see each account's weekly usage",
  "type": "module",
  "main": "./index.ts",
  "exports": "./index.ts",
  "files": [
    "index.ts",
    "engine/",
    "engine-go/bin/",
    "assets/",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 contract.test.ts \"test/*.test.ts\" connector/contract.test.ts",
    "pretest": "npm run build:engine",
    "build:engine": "node tools/build-engine.ts",
    "test:go": "go -C engine-go test ./...",
    "bench": "go -C engine-go test -bench . -benchmem ./...",
    "typecheck": "tsc --noEmit",
    "no-javascript": "node tools/no-javascript.ts"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "muse",
    "muse-ai",
    "muse-spark"
  ],
  "author": "JohnWang (https://github.com/JohnWangggg)",
  "license": "MIT",
  "homepage": "https://github.com/JohnWangggg/magpie-muse-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnWangggg/magpie-muse-web.git"
  },
  "bugs": {
    "url": "https://github.com/JohnWangggg/magpie-muse-web/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 1
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  }
}
